{
  "id": "catalog",
  "type": "module",
  "version": "1.1.0",
  "name": "Catalog",
  "core": ">=0.5.0,<0.6.0",
  "dependencies": [],
  "conflicts": [],
  "permissions": [
    {
      "id": "catalog.manage",
      "description": "Manage catalog products, categories and attributes"
    }
  ],
  "settings": [
    {"key": "page-size", "secret": false},
    {"key": "default-status", "secret": false}
  ],
  "services": [
    {"contract": "catalog.query", "version": "1.0.0"},
    {"contract": "catalog.products", "version": "1.0.0"},
    {"contract": "catalog.categories", "version": "1.0.0"},
    {"contract": "catalog.attributes", "version": "1.0.0"}
  ],
  "events": [
    {"contract": "catalog.changed", "version": "1.0.0"},
    {"contract": "catalog.productChanged", "version": "1.0.0"},
    {"contract": "catalog.categoryChanged", "version": "1.0.0"},
    {"contract": "catalog.attributeChanged", "version": "1.0.0"}
  ],
  "provides": [
    {"id": "catalog.products", "version": "1.0.0"},
    {"id": "catalog.categories", "version": "1.0.0"},
    {"id": "catalog.attributes", "version": "1.0.0"}
  ],
  "requires": [],
  "migrations": [
    {"version": "001_init", "path": "sql/001_init.sql"},
    {"version": "002_catalog_v1", "path": "sql/002_catalog_v1.sql"}
  ],
  "storage": [
    {"id": "catalog.media", "kind": "media"}
  ],
  "admin": {
    "commands": [
      {"id": "catalog.products.list", "permission": "catalog.manage"},
      {"id": "catalog.products.get", "permission": "catalog.manage"},
      {"id": "catalog.products.create", "permission": "catalog.manage"},
      {"id": "catalog.products.update", "permission": "catalog.manage"},
      {"id": "catalog.products.archive", "permission": "catalog.manage"},
      {"id": "catalog.categories.list", "permission": "catalog.manage"},
      {"id": "catalog.categories.get", "permission": "catalog.manage"},
      {"id": "catalog.categories.create", "permission": "catalog.manage"},
      {"id": "catalog.categories.update", "permission": "catalog.manage"},
      {"id": "catalog.attributes.list", "permission": "catalog.manage"},
      {"id": "catalog.attributes.create", "permission": "catalog.manage"},
      {"id": "catalog.attributes.update", "permission": "catalog.manage"},
      {"id": "catalog.attributes.options", "permission": "catalog.manage"}
    ]
  },
  "web": {
    "hooks": [],
    "slots": [
      {
        "slot": "storefront.collection.products",
        "template": "product-grid.html",
        "position": 100
      },
      {
        "slot": "storefront.product.gallery",
        "template": "product-gallery.html",
        "position": 100
      },
      {
        "slot": "storefront.product.variants",
        "template": "product-variants.html",
        "position": 100
      }
    ]
  },
  "public": {
    "queries": [
      {"id": "products", "access": "anonymous_read", "input_schema": {"type": "object", "properties": {}, "additional_properties": false}, "response_schema": {"type": "object", "properties": {"items": {"type": "array", "items": {"type": "object", "properties": {}, "additional_properties": true}, "max_items": 128}}, "required": ["items"], "additional_properties": false}},
      {"id": "product", "access": "anonymous_read", "input_schema": {"type": "object", "properties": {"product_id": {"type": "string", "max_length": 128}}, "required": ["product_id"], "additional_properties": false}, "response_schema": {"type": "object", "properties": {}, "additional_properties": true}},
      {"id": "category", "access": "anonymous_read", "input_schema": {"type": "object", "properties": {"category_id": {"type": "string", "max_length": 128}}, "required": ["category_id"], "additional_properties": false}, "response_schema": {"type": "object", "properties": {}, "additional_properties": true}},
      {"id": "categories", "access": "anonymous_read", "input_schema": {"type": "object", "properties": {}, "additional_properties": false}, "response_schema": {"type": "object", "properties": {"items": {"type": "array", "items": {"type": "object", "properties": {}, "additional_properties": true}, "max_items": 128}}, "required": ["items"], "additional_properties": false}}
    ],
    "actions": [],
    "page_projections": [
      {"id": "home", "page_key": "home", "access": "anonymous_read", "input_schema": {"type": "object", "properties": {}, "additional_properties": false}, "response_schema": {"type": "object", "properties": {}, "additional_properties": true}},
      {"id": "catalog", "page_key": "catalog", "access": "anonymous_read", "input_schema": {"type": "object", "properties": {}, "additional_properties": false}, "response_schema": {"type": "object", "properties": {}, "additional_properties": true}},
      {"id": "category", "page_key": "category", "access": "anonymous_read", "input_schema": {"type": "object", "properties": {}, "additional_properties": false}, "response_schema": {"type": "object", "properties": {}, "additional_properties": true}},
      {"id": "product", "page_key": "product", "access": "anonymous_read", "input_schema": {"type": "object", "properties": {}, "additional_properties": false}, "response_schema": {"type": "object", "properties": {}, "additional_properties": true}}
    ],
    "sitemap_projections": [{"id": "products", "access": "anonymous_read", "input_schema": {"type": "object", "properties": {}, "additional_properties": false}, "response_schema": {"type": "array", "items": {"type": "string", "max_length": 256}, "max_items": 128}}]
  }
}
