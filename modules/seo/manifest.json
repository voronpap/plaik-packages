{
  "id": "seo",
  "type": "module",
  "version": "1.0.1",
  "name": "SEO",
  "core": ">=0.4.0,<0.6.0",
  "dependencies": [{"package_id": "catalog", "version": ">=1.0.0,<2.0.0"}],
  "conflicts": [],
  "permissions": [{"id": "seo.manage", "description": "Manage storefront SEO records"}],
  "settings": [{"key": "canonical-host", "secret": false}],
  "services": [
    {"contract": "seo.query", "version": "1.0.0"},
    {"contract": "seo.storefront", "version": "1.0.0"}
  ],
  "events": [
    {"contract": "seo.changed", "version": "1.0.0"},
    {"contract": "seo.recordChanged", "version": "1.0.0"}
  ],
  "provides": [{"id": "seo.storefront", "version": "1.0.0"}],
  "requires": [{"id": "catalog.products", "version": ">=1.0.0,<2.0.0"}],
  "migrations": [
    {"version": "001_init", "path": "sql/001_init.sql"},
    {"version": "002_seo_v1", "path": "sql/002_seo_v1.sql"}
  ],
  "storage": [],
  "admin": {
    "commands": [
      {"id": "seo.records.list", "permission": "seo.manage"},
      {"id": "seo.records.get", "permission": "seo.manage"},
      {"id": "seo.records.set", "permission": "seo.manage"}
    ]
  },
  "web": {
    "hooks": [],
    "slots": [
      {
        "slot": "storefront.seo.structured-data",
        "template": "structured-data.html",
        "position": 100
      }
    ]
  },
  "public": {"queries": [{"id": "metadata", "access": "anonymous_read", "input_schema": {"type": "object", "properties": {"product_id": {"type": "string", "max_length": 128}}, "required": ["product_id"], "additional_properties": false}, "response_schema": {"type": "object", "properties": {}, "additional_properties": true}}], "actions": [], "page_projections": [], "sitemap_projections": []}
}
