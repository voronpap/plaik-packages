{
  "id": "pricing",
  "type": "module",
  "version": "1.0.1",
  "name": "Pricing",
  "core": ">=0.4.0,<0.6.0",
  "dependencies": [{"package_id": "catalog", "version": ">=1.0.0,<2.0.0"}],
  "conflicts": [],
  "permissions": [{"id": "pricing.manage", "description": "Manage list prices"}],
  "settings": [{"key": "currency", "secret": false}],
  "services": [
    {"contract": "pricing.query", "version": "1.0.0"},
    {"contract": "pricing.list", "version": "1.0.0"}
  ],
  "events": [
    {"contract": "pricing.changed", "version": "1.0.0"},
    {"contract": "pricing.listChanged", "version": "1.0.0"}
  ],
  "provides": [{"id": "pricing.list", "version": "1.0.0"}],
  "requires": [{"id": "catalog.products", "version": ">=1.0.0,<2.0.0"}],
  "migrations": [
    {"version": "001_init", "path": "sql/001_init.sql"},
    {"version": "002_pricing_v1", "path": "sql/002_pricing_v1.sql"}
  ],
  "storage": [],
  "admin": {
    "commands": [
      {"id": "pricing.list.list", "permission": "pricing.manage"},
      {"id": "pricing.list.get", "permission": "pricing.manage"},
      {"id": "pricing.list.set", "permission": "pricing.manage"}
    ]
  },
  "web": {
    "hooks": [],
    "slots": [
      {
        "slot": "storefront.product.after-price",
        "template": "after-price.html",
        "position": 100
      }
    ]
  }
}
