{
  "id": "search",
  "type": "module",
  "version": "0.1.0",
  "name": "Search",
  "core": ">=0.4.0,<0.5.0",
  "dependencies": [{"package_id": "catalog", "version": ">=0.1.0,<0.2.0"}],
  "conflicts": [],
  "permissions": [{"id": "search.manage", "description": "Manage search facets"}],
  "settings": [{"key": "facet-limit", "secret": false}],
  "services": [{"contract": "search.query", "version": "1.0.0"}],
  "events": [{"contract": "search.reindexed", "version": "1.0.0"}],
  "provides": [{"id": "search.facets", "version": "1.0.0"}],
  "requires": [{"id": "catalog.products", "version": ">=1.0.0,<2.0.0"}],
  "migrations": [{"version": "001_init", "path": "sql/001_init.sql"}],
  "storage": [],
  "web": {
    "hooks": [],
    "slots": [
      {
        "slot": "storefront.search.filters",
        "template": "templates/facets.html",
        "position": 100
      }
    ]
  }
}
