  "public": {"queries": [{"id": "search", "access": "anonymous_read", "input_schema": {"type": "object", "properties": {"q": {"type": "string", "max_length": 128}}, "additional_properties": false}, "response_schema": {"type": "object", "properties": {"items": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string", "max_length": 128}, "sku": {"type": "string", "max_length": 128}, "title": {"type": "string", "max_length": 512}}, "required": ["id", "sku", "title"], "additional_properties": false}, "max_items": 128}, "facets": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string", "max_length": 128}, "value": {"type": "string", "max_length": 512}, "product_count": {"type": "integer"}}, "required": ["name", "value", "product_count"], "additional_properties": false}, "max_items": 128}}, "required": ["items", "facets"], "additional_properties": false}}], "actions": [], "page_projections": [{"id": "search", "page_key": "search", "access": "anonymous_read", "input_schema": {"type": "object", "properties": {}, "additional_properties": false}, "response_schema": {"type": "object", "properties": {"items": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string", "max_length": 128}, "sku": {"type": "string", "max_length": 128}, "title": {"type": "string", "max_length": 512}}, "required": ["id", "sku", "title"], "additional_properties": false}, "max_items": 128}, "facets": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string", "max_length": 128}, "value": {"type": "string", "max_length": 512}, "product_count": {"type": "integer"}}, "required": ["name", "value", "product_count"], "additional_properties": false}, "max_items": 128}}, "required": ["items", "facets"], "additional_properties": false}}], "sitemap_projections": []}
