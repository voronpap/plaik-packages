  "dependencies": [
    {"package_id": "catalog", "version": ">=1.0.0,<2.0.0"},
    {"package_id": "pricing", "version": ">=1.0.0,<2.0.0"},
    {"package_id": "inventory", "version": ">=1.0.0,<2.0.0"},
    {"package_id": "cart", "version": ">=1.0.0,<2.0.0"},
    {"package_id": "orders", "version": ">=1.0.0,<2.0.0"},
    {"package_id": "shipping", "version": ">=1.0.0,<2.0.0"},
    {"package_id": "payments", "version": ">=1.0.0,<2.0.0"},
    {"package_id": "promotions", "version": ">=1.0.0,<2.0.0"}
  ],
  "conflicts": [],
  "permissions": [{"id": "checkout.manage", "description": "Place store checkout orders"}],
  "settings": [],
  "services": [
