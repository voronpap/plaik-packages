    {"id": "cart.lines", "version": ">=1.0.0,<2.0.0"},
    {"id": "orders.records", "version": ">=1.0.0,<2.0.0"},
    {"id": "shipping.methods", "version": ">=1.0.0,<2.0.0"},
    {"id": "payments.capture", "version": ">=1.0.0,<2.0.0"},
    {"id": "promotions.coupons", "version": ">=1.0.0,<2.0.0"}
